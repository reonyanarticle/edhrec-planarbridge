{
  "name": "edhrec-planarbridge",
  "version": "1.0.0",
  "description": "EDHRECのカードページに日本のMTGショップへのリンクを追加するブラウザ拡張機能",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--localstorage-file=.node-storage' wxt",
    "dev:firefox": "NODE_OPTIONS='--localstorage-file=.node-storage' wxt -b firefox",
    "dev:edge": "NODE_OPTIONS='--localstorage-file=.node-storage' wxt -b edge",
    "build": "NODE_OPTIONS='--localstorage-file=.node-storage' wxt build",
    "build:firefox": "NODE_OPTIONS='--localstorage-file=.node-storage' wxt build -b firefox",
    "build:edge": "NODE_OPTIONS='--localstorage-file=.node-storage' wxt build -b edge",
    "zip": "NODE_OPTIONS='--localstorage-file=.node-storage' wxt zip",
    "zip:firefox": "NODE_OPTIONS='--localstorage-file=.node-storage' wxt zip -b firefox",
    "zip:edge": "NODE_OPTIONS='--localstorage-file=.node-storage' wxt zip -b edge",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "mtg",
    "edhrec",
    "browser-extension",
    "wxt"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "wxt": "^0.20.13",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.36",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "@wxt-dev/module-react": "^1.1.5",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.58.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
